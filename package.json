{
  "name": "@archally/brandvoice-schema",
  "version": "1.9.0",
  "description": "YAML-based schema for brand communication strategy modeling: market reality, brand strategy, activation, and governance",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Adam Walkowski <adam.walkowski@inperceptic.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/archally/brandvoice-schema"
  },
  "homepage": "https://archally.pro",
  "keywords": [
    "brandvoice",
    "brand-strategy",
    "marketing",
    "schema",
    "yaml",
    "json-schema",
    "positioning",
    "messaging",
    "competitive-intelligence",
    "storybrand"
  ],
  "type": "module",
  "exports": {
    "./schema/v1.9/*": "./schema/v1.9/*",
    "./model": "./tools/model-builder/dist/index.js"
  },
  "files": [
    "schema/",
    "tools/",
    "docs/",
    "examples/",
    "LICENSE",
    "LICENSE-APACHE",
    "LICENSE-FSL",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "validate": "node tools/validator/src/cli.mjs",
    "validate:examples": "node tools/validator/src/cli.mjs examples/fitness-app/.brandvoice/v1.9 --schemas schema/v1.9 && node tools/validator/src/cli.mjs examples/time-management/.brandvoice/v1.9 --schemas schema/v1.9",
    "check": "node tools/semantic-checker/dist/cli.js",
    "check:examples": "node tools/semantic-checker/dist/cli.js examples/fitness-app/.brandvoice/v1.9 && node tools/semantic-checker/dist/cli.js examples/time-management/.brandvoice/v1.9",
    "model": "node tools/model-builder/dist/cli.js",
    "build": "tsc -p tools/model-builder/tsconfig.json && tsc -p tools/semantic-checker/tsconfig.json",
    "test": "node tools/port/run-test-suites.mjs",
    "release:check": "node tools/port/release-check.mjs --expect 1.9.0 && npm run atlas:check && npm run docs:check && npm run doc-snippets",
    "prepublishOnly": "npm run build",
    "port:verify": "node tools/port/verify-ported.mjs",
    "port:test": "node --test tools/port/*.test.mjs",
    "atlas": "node tools/schema-atlas/cli.mjs generate",
    "atlas:check": "node tools/schema-atlas/cli.mjs check",
    "doc-snippets": "node tools/doc-snippet-validate/cli.mjs README.md",
    "docs:check": "node tools/port/docs-check.mjs"
  },
  "bin": {
    "brandvoice-validate": "tools/validator/src/cli.mjs",
    "brandvoice-check": "tools/semantic-checker/dist/cli.js",
    "brandvoice-model": "tools/model-builder/dist/cli.js"
  },
  "dependencies": {
    "@archally/semantic-checker": "github:archally/semantic-checker#v0.1.0",
    "ajv": "^8.17.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "testSuites": [
    {
      "name": "model-builder",
      "argv": [
        "node",
        "node_modules/vitest/vitest.mjs",
        "run",
        "--config",
        "tools/model-builder/vitest.config.ts"
      ]
    },
    {
      "name": "semantic-checker",
      "argv": [
        "node",
        "node_modules/vitest/vitest.mjs",
        "run",
        "--config",
        "tools/semantic-checker/vitest.config.ts"
      ]
    },
    {
      "name": "portable-tools",
      "argv": [
        "node",
        "--test",
        "--test-reporter=tap",
        "tools/doc-snippet-validate/snippets.test.mjs",
        "tools/entity-query/query.test.mjs",
        "tools/port/docs-check.test.mjs",
        "tools/port/release-check.test.mjs",
        "tools/port/run-test-suites.test.mjs",
        "tools/port/verify-ported.test.mjs",
        "tools/schema-atlas/atlas.test.mjs",
        "tools/validator/src/references.test.mjs"
      ]
    }
  ],
  "requiredTestSuites": [
    "model-builder",
    "semantic-checker",
    "portable-tools"
  ]
}
