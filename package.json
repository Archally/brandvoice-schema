{
  "name": "@archally/brandvoice-schema",
  "version": "1.6.2",
  "description": "YAML-based schema for brand communication strategy modeling — market reality, brand strategy, activation, and governance",
  "license": "Apache-2.0",
  "author": "Adam Walkowski <adam.walkowski@inperceptic.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/archally/brandvoice-schema"
  },
  "homepage": "https://archally.pro",
  "keywords": [
    "brandvoice",
    "brand-strategy",
    "marketing",
    "schema",
    "yaml",
    "json-schema",
    "positioning",
    "messaging",
    "competitive-intelligence",
    "storybrand"
  ],
  "type": "module",
  "exports": {
    "./schema/v1.6/*": "./schema/v1.6/*",
    "./model": "./tools/model-builder/dist/index.js"
  },
  "files": [
    "schema/",
    "tools/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "validate": "node tools/validator/src/cli.mjs",
    "check": "node tools/semantic-checker/dist/cli.js",
    "model": "node tools/model-builder/dist/cli.js",
    "build": "tsc -p tools/model-builder/tsconfig.json && tsc -p tools/semantic-checker/tsconfig.json",
    "test": "vitest run --config tools/model-builder/vitest.config.ts && vitest run --config tools/semantic-checker/vitest.config.ts",
    "prepublishOnly": "npm run build"
  },
  "bin": {
    "brandvoice-validate": "tools/validator/src/cli.mjs",
    "brandvoice-check": "tools/semantic-checker/dist/cli.js",
    "brandvoice-model": "tools/model-builder/dist/cli.js"
  },
  "dependencies": {
    "@archally/semantic-checker": "github:archally/semantic-checker#v0.1.0",
    "ajv": "^8.17.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
